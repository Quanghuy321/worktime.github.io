{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        ".validate": "newData.hasChildren(['uid','email','role','status']) && newData.child('uid').val() === $uid && (!data.exists() || newData.child('role').val() === data.child('role').val() || root.child('users').child(auth.uid).child('role').val() === 'superadmin')"
      }
    },
    "attendance": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        "$date": {
          ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
          ".validate": "newData.hasChildren(['uid','date']) && newData.child('uid').val() === $uid && newData.child('date').val() === $date"
        }
      }
    },
    "attendanceSettings": {
      "geofence": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        ".validate": "newData.hasChildren(['enabled','name','latitude','longitude','radiusMeters','updatedAt','updatedBy']) && newData.child('enabled').val() === true && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 80 && newData.child('latitude').isNumber() && newData.child('latitude').val() >= -90 && newData.child('latitude').val() <= 90 && newData.child('longitude').isNumber() && newData.child('longitude').val() >= -180 && newData.child('longitude').val() <= 180 && newData.child('radiusMeters').isNumber() && newData.child('radiusMeters').val() >= 50 && newData.child('radiusMeters').val() <= 2000 && newData.child('updatedAt').isNumber() && newData.child('updatedBy').val() === auth.uid"
      }
    },
    "leaves": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        "$leaveId": {
          ".write": "auth != null && ((auth.uid === $uid && ((!data.exists() && newData.exists() && newData.child('status').val() === 'pending') || (!newData.exists() && data.child('status').val() === 'pending'))) || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
          ".validate": "newData.hasChildren(['uid']) && newData.child('uid').val() === $uid"
        }
      }
    },
    "payroll": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        "$month": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
          ".validate": "newData.hasChildren(['uid','month']) && newData.child('uid').val() === $uid && newData.child('month').val() === $month"
        }
      }
    },
    "payrollHolidays": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$month": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        "$date": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "salaryAdvances": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
        "$requestId": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending') || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'superadmin')",
          ".validate": "newData.hasChildren(['uid','month','amount','reason','status']) && newData.child('uid').val() === $uid && newData.child('amount').isNumber() && newData.child('amount').val() > 0 && newData.child('status').val().matches(/^(pending|approved|rejected)$/)"
        }
      }
    }
  }
}
