rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
             && (
               request.auth.token.admin == true
               || request.auth.token.role in ['admin', 'superadmin']
               || (
                 exists(
                   /databases/$(database)/documents/adminRoles/$(request.auth.uid)
                 )
                 && get(
                   /databases/$(database)/documents/adminRoles/$(request.auth.uid)
                 ).data.role in ['admin', 'superadmin']
               )
             );
    }

    match /adminRoles/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /avatars/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.keys().hasAll([
                              'imageData',
                              'contentType',
                              'updatedAt'
                            ])
                            && request.resource.data.keys().hasOnly([
                              'imageData',
                              'contentType',
                              'updatedAt'
                            ])
                            && request.resource.data.imageData is string
                            && request.resource.data.imageData.size() <= 716800
                            && request.resource.data.imageData.matches(
                              '^data:image/webp;base64,[A-Za-z0-9+/]+={0,2}$'
                            )
                            && request.resource.data.contentType == 'image/webp'
                            && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /salaryAdvanceReviews/{reviewId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.uid || isAdmin());
      allow create, update: if isAdmin()
                            && request.resource.data.keys().hasAll([
                              'uid',
                              'requestId',
                              'imageData',
                              'contentType',
                              'status',
                              'createdBy',
                              'updatedAt'
                            ])
                            && request.resource.data.keys().hasOnly([
                              'uid',
                              'requestId',
                              'imageData',
                              'contentType',
                              'status',
                              'createdBy',
                              'updatedAt'
                            ])
                            && request.resource.data.uid is string
                            && request.resource.data.requestId is string
                            && request.resource.data.imageData is string
                            && request.resource.data.imageData.size() <= 716800
                            && request.resource.data.imageData.matches(
                              '^data:image/webp;base64,[A-Za-z0-9+/]+={0,2}$'
                            )
                            && request.resource.data.contentType == 'image/webp'
                            && request.resource.data.status in ['approved', 'rejected']
                            && request.resource.data.createdBy == request.auth.uid
                            && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }
  }
}
